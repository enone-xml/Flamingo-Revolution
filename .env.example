# Copy this file to .env and fill in real values. Never commit .env.
ANTHROPIC_API_KEY=
# Model used for summaries/translations
AI_MODEL=claude-haiku-4-5-20251001
# Stop AI calls once this month's estimated spend passes this many USD
AI_MONTHLY_BUDGET_USD=5
# Set to "fake" to test without an API key (writes placeholder summaries)
AI_MODE=real
# Minutes between fetch runs
FETCH_INTERVAL_MINUTES=10
# Where the SQLite file lives (inside the container)
DB_PATH=/data/flamingo.db
# Public URL of the site, used in feed.xml and the User-Agent
SITE_URL=http://localhost:8000

# Port on your machine/server that the site listens on (Caddy proxies to it)
HOST_PORT=8080

# Production only: your domain, without https:// (e.g. flamingowatch.com)
DOMAIN=

# --- Static-site mode (run on your PC, publish to free Cloudflare Pages) ---
# Write a static copy of the site here after every fetch run.
EXPORT_DIR=/export
# Turn on the publisher (and optionally the auto-updater) containers.
COMPOSE_PROFILES=publish,autoupdate
# Cloudflare: API token with "Cloudflare Pages: Edit" permission, and your account ID.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CF_PAGES_PROJECT=flamingo-watch
# Optional: a healthchecks.io ping URL; it emails you if publishing stops.
HEALTHCHECK_URL=

# --- Auto-update from GitHub (profile "autoupdate") ---
# Every 5 minutes, deploy new commits on main whose tests passed.
GITHUB_REPO=enone-xml/Flamingo-Revolution
# Group ID that owns /var/run/docker.sock (check with: ls -ln /var/run/docker.sock)
DOCKER_GID=1001
# Once AI works again (credit topped up, new month), summarise headline-only
# articles from this many recent days.
AI_CATCHUP_DAYS=3

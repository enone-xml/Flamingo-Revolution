# Copy this file to .env and fill in real values. Never commit .env.
ANTHROPIC_API_KEY=
# Model used for summaries/translations
AI_MODEL=claude-haiku-4-5-20251001
# Stop AI calls once this month's estimated spend passes this many USD
AI_MONTHLY_BUDGET_USD=4
# Set to "fake" to test without an API key (writes placeholder summaries)
AI_MODE=real
# Minutes between fetch runs
FETCH_INTERVAL_MINUTES=10
# Where the SQLite file lives (inside the container)
DB_PATH=/data/flamingo.db
# Public URL of the site, used in feed.xml and the User-Agent
SITE_URL=http://localhost:8000

# Port on your machine/server that the site listens on (Caddy proxies to it)
HOST_PORT=8080

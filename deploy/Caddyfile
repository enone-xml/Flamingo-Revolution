# Caddy gets and renews the HTTPS certificate for $DOMAIN automatically.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:8000
	header Strict-Transport-Security "max-age=31536000"
	log {
		output stdout
		format console
	}
}

# Send www to the bare domain.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
